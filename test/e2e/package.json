{
  "name": "@pinception/e2e-tests",
  "version": "1.0.0",
  "description": "End-to-end tests for Pinception",
  "private": true,
  "scripts": {
    "test": "npm run test:initial-pin && npm run test:periodic-check && npm run test:challenge",
    "test:initial-pin": "tsx test-initial-pin.ts",
    "test:periodic-check": "tsx test-periodic-check.ts",
    "test:challenge": "tsx test-challenge-resolution.ts",
    "test:all": "npm run test"
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "ethers": "^6.9.0",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/node-fetch": "^2.6.9",
    "tsx": "^4.7.0",
    "typescript": "^5.3.2"
  }
}
